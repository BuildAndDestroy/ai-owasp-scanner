# Copy to .env and change secrets. Docker Compose reads this file for variable substitution.

MONGO_ROOT_USERNAME=owasp
MONGO_ROOT_PASSWORD=changeme_generate_a_strong_password

# Optional: full URI override (used by the dashboard when set). If unset, Compose builds the URI
# from MONGO_ROOT_* above; local `go run ./cmd/dashboard` builds from MONGO_ROOT_* + MONGO_HOST.
# MONGODB_URI=mongodb://owasp:changeme_generate_a_strong_password@127.0.0.1:27017/?authSource=admin

# Optional: host:port for local dashboard when building URI from MONGO_ROOT_* (default 127.0.0.1:27017)
# MONGO_HOST=127.0.0.1:27017

MONGODB_DATABASE=owasp_dashboard
